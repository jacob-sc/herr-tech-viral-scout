# Copy to .env.local and fill in your keys

# Anthropic API Key — https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Apify API Token — https://console.apify.com → Settings → Integrations
APIFY_TOKEN=

# YouTube Data API v3 Key (Phase 2) — https://console.cloud.google.com
YOUTUBE_API_KEY=
